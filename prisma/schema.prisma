generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AvailabilityStatus {
  OPEN
  BUSY
  NOT_LOOKING
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  handle        String?   @unique
  birthYear     Int?
  birthDate     String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // GitHub Integration
  githubAccessToken  String?    // Store GitHub OAuth token
  githubUsername     String?    // GitHub username
  lastGithubSyncAt   DateTime?  // Last successful sync timestamp

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  settings      UserSettings?
  repositories  Repository[]
  contributions GitHubContribution[]
  resumes       Resume[]
}

model Profile {
  id                   String       @id @default(cuid())
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String       @unique

  headline             String?
  bio                  String?
  location             String?
  currentCompany       String?
  currentRole          String?

  githubUrl            String?
  linkedinUrl          String?
  websiteUrl           String?
  twitterUrl           String?
  externalPortfolioUrl String?
  pdfTextContext       String?

  services             Json?        // Array of services offered e.g. [{ title, description, icon }]
  customSections       Json?        // Array of custom sections e.g. [{ title, content }]

  isPublic             Boolean      @default(true)

  experiences          Experience[]
  projects             Project[]
  skills               Skill[]
  snapshots            ProfileSnapshot[]

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String

  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean  @default(false)
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String

  name        String
  description String?
  url         String?
  highlight   Boolean  @default(false)
  techStack   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  name      String
  level     String?

  createdAt DateTime @default(now())
}

model ProfileSnapshot {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  
  data      Json     // Store full profile state as JSON
  summary   String?  // Optional: "Synced from GitHub", "Manual Save", etc.
  
  createdAt DateTime @default(now())

  @@index([profileId])
}

model UserSettings {
  id               String             @id @default(cuid())
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String             @unique
  availability     AvailabilityStatus @default(OPEN)
  activelyLooking  Boolean            @default(true)
  hideMatchesUntil DateTime?
  premium          Boolean            @default(false)
  
  // GitHub Sync Settings
  autoGithubSync   Boolean            @default(true)
  syncFrequency    String             @default("daily") // daily, weekly, manual
  theme            String             @default("dark")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  provider           String
  providerAccountId  String

  refresh_token      String?
  refresh_token_expires_in Int?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  @@unique([provider, providerAccountId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires       DateTime
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Repository {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  
  githubId        Int      @unique
  name            String
  fullName        String   // owner/repo
  description     String?
  url             String
  homepage        String?
  
  language        String?
  stars           Int      @default(0)
  forks           Int      @default(0)
  isPrivate       Boolean  @default(false)
  isFork          Boolean  @default(false)
  
  topics          String[] // Array of topics/tags
  createdAt       DateTime
  updatedAt       DateTime
  lastPushedAt    DateTime?
  
  importedAt      DateTime @default(now())
}

model GitHubContribution {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  
  date            DateTime
  count           Int      @default(0)
  level           String   // NONE, LOW, MEDIUM, HIGH, VERY_HIGH
  
  @@unique([userId, date])
}

enum ResumeTemplateStyle {
  SAJID_STANDARD
  MEHRAB_MINIMAL
}

model Resume {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String              @unique
  title         String              @default("My Resume")
  templateStyle ResumeTemplateStyle @default(SAJID_STANDARD)
  isPublic      Boolean             @default(true)

  // Stored JSON payload of full resume content
  content       Json

  questions     ResumeQuestion[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId])
}

model ResumeQuestion {
  id        String   @id @default(cuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  question  String
  category  String?
  answer    String?
  createdAt DateTime @default(now())

  @@index([resumeId])
}

