generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AvailabilityStatus {
  OPEN
  BUSY
  NOT_LOOKING
}

enum UserRole {
  DEVELOPER // Seller: Applies to jobs, generates resume & portfolio
  CLIENT    // Buyer: Posts jobs & freelance tasks, hires developers
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  handle        String?   @unique
  birthYear     Int?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Dual User Role (Fiverr Seller vs Buyer)
  role          UserRole?
  roleSelected  Boolean   @default(false)

  // GitHub Integration
  githubAccessToken  String?    // Store GitHub OAuth token
  githubUsername     String?    // GitHub username
  lastGithubSyncAt   DateTime?  // Last successful sync timestamp

  // Gmail Integration
  gmailAccessToken  String?    // Gmail OAuth access token
  gmailRefreshToken String?    // Gmail OAuth refresh token
  gmailConnectedAt  DateTime?  // When Gmail was connected
  gmailEmail        String?    // The connected Gmail address

  accounts       Account[]
  sessions       Session[]
  profile        Profile?
  settings       UserSettings?
  repositories   Repository[]
  contributions  GitHubContribution[]
  resumes        Resume[]
  jobApplications JobApplication[]
  jobCrawlQueue  JobCrawlQueue[]
  marketplaceJobs MarketplaceJob[]
}

model Profile {
  id                   String       @id @default(cuid())
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String       @unique

  headline             String?
  bio                  String?
  location             String?
  currentCompany       String?
  currentRole          String?

  githubUrl            String?
  linkedinUrl          String?
  websiteUrl           String?
  twitterUrl           String?
  externalPortfolioUrl String?
  pdfTextContext       String?

  services             Json?        // Array of services offered e.g. [{ title, description, icon }]
  customSections       Json?        // Array of custom sections e.g. [{ title, content }]

  isPublic             Boolean      @default(true)

  experiences          Experience[]
  projects             Project[]
  skills               Skill[]
  snapshots            ProfileSnapshot[]

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String

  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean  @default(false)
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String

  name        String
  description String?
  url         String?
  highlight   Boolean  @default(false)
  techStack   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  name      String
  level     String?

  createdAt DateTime @default(now())
}

model ProfileSnapshot {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  
  data      Json     // Store full profile state as JSON
  summary   String?  // Optional: "Synced from GitHub", "Manual Save", etc.
  
  createdAt DateTime @default(now())

  @@index([profileId])
}

model UserSettings {
  id               String             @id @default(cuid())
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String             @unique
  availability     AvailabilityStatus @default(OPEN)
  activelyLooking  Boolean            @default(true)
  hideMatchesUntil DateTime?
  premium          Boolean            @default(false)
  
  // GitHub Sync Settings
  autoGithubSync   Boolean            @default(true)
  syncFrequency    String             @default("daily") // daily, weekly, manual
  theme            String             @default("dark")

  // Custom Outgoing Email / SMTP Dispatch Settings (Per-User Isolation)
  smtpHost         String?            @default("smtp.gmail.com")
  smtpPort         Int?               @default(587)
  smtpUser         String?
  smtpPass         String?
  smtpFromName     String?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String
  provider           String
  providerAccountId  String

  refresh_token      String?
  refresh_token_expires_in Int?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  @@unique([provider, providerAccountId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires       DateTime
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Repository {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  
  githubId        Int      @unique
  name            String
  fullName        String   // owner/repo
  description     String?
  url             String
  homepage        String?
  
  language        String?
  stars           Int      @default(0)
  forks           Int      @default(0)
  isPrivate       Boolean  @default(false)
  isFork          Boolean  @default(false)
  
  topics          String[] // Array of topics/tags
  createdAt       DateTime
  updatedAt       DateTime
  lastPushedAt    DateTime?
  
  importedAt      DateTime @default(now())
}

model GitHubContribution {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  
  date            DateTime
  count           Int      @default(0)
  level           String   // NONE, LOW, MEDIUM, HIGH, VERY_HIGH
  
  @@unique([userId, date])
}

enum ResumeTemplateStyle {
  SAJID_STANDARD
  MEHRAB_MINIMAL
}

model Resume {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String              @unique
  title         String              @default("My Resume")
  templateStyle ResumeTemplateStyle @default(SAJID_STANDARD)
  isPublic      Boolean             @default(true)

  // Stored JSON payload of full resume content
  content       Json

  questions     ResumeQuestion[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId])
}

model ResumeQuestion {
  id        String   @id @default(cuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  question  String
  category  String?
  answer    String?
  createdAt DateTime @default(now())

  @@index([resumeId])
}

// ============================================================
// JOB APPLICATION FEATURE MODELS
// ============================================================

enum JobApplicationStatus {
  DRAFT          // JD pasted, not yet processed
  ANALYZED       // Match score calculated
  POLISHING      // Resume being polished for this job
  READY          // Resume + Cover Letter ready
  SENT           // Application email sent
  ARCHIVED       // User archived it
}

model JobApplication {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Job details
  jobTitle    String?
  company     String?
  location    String?
  jdUrl       String?             // If user pasted a JD link
  jdText      String               // The full job description text (pasted or fetched)
  jdSource    String              @default("manual") // manual, link, crawl

  // AI Analysis
  matchScore  Int?                // 0-100 match score
  matchReasons Json?              // Array of { reason, matched, missing }
  analyzedAt  DateTime?

  // Email application
  recipientEmail String?           // Hiring manager / recruiter email
  emailSubject   String?           // Email subject line
  emailBody      String?           // Email body text
  sentAt         DateTime?

  // Application Options & Q&A
  optimizeResume Boolean              @default(false)
  qaPairs        Json?                // Array of { id, question, answer, createdAt }

  status      JobApplicationStatus @default(DRAFT)

  // Relations
  resumeVersion  ResumeVersion?
  coverLetter    CoverLetter?

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

model ResumeVersion {
  id              String   @id @default(cuid())
  jobApplicationId String   @unique
  jobApplication  JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  // The polished resume content (JSON, same structure as Resume.content)
  content         Json

  // AI metadata
  polishNotes     String?  // What was changed/optimized
  polishSummary   String?  // Summary of changes

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CoverLetter {
  id              String   @id @default(cuid())
  jobApplicationId String   @unique
  jobApplication  JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  // The cover letter text (editable)
  content         String

  // AI metadata
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// FUTURE: JD CRAWLING (3 jobs/day per user)
// This model is a placeholder for the future crawling feature.
// It will store crawled job postings that match the user's profile.
// ============================================================

model JobCrawlQueue {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Crawled job data
  jobTitle    String
  company     String
  location    String?
  url         String
  jdText      String?   // Fetched JD text (null until fetched)
  source      String    @default("crawl") // crawl, api, manual

  // Matching
  matchScore  Int?
  matchReasons Json?

  // Processing status
  status      String    @default("pending") // pending, fetched, matched, shown, dismissed
  shownAt     DateTime?  // When shown to user

  // Daily quota tracking (3 jobs/day per user)
  crawlDate   DateTime   @default(now())

  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([crawlDate])
  @@index([status])
}

// ============================================================
// EMAIL + OTP AUTHENTICATION MODEL
// ============================================================

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ============================================================
// MARKETPLACE & CLIENT JOB / FREELANCE TASK POSTING MODELS
// ============================================================

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE_TASK
}

model MarketplaceJob {
  id          String   @id @default(cuid())
  postedById  String
  postedBy    User     @relation(fields: [postedById], references: [id], onDelete: Cascade)
  title       String
  company     String
  type        JobType  @default(FULL_TIME)
  budget      String?  // e.g. "$500" or "$80k-$100k"
  location    String?  // e.g. "Remote", "Dhaka, Bangladesh"
  description String
  applyEmail  String
  status      String   @default("OPEN") // OPEN, CLOSED

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([postedById])
  @@index([type])
  @@index([status])
}

